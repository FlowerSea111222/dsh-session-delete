{
  "name": "@local/dsh-session-delete",
  "version": "1.0.0",
  "private": true,
  "description": "Delete a stored Session permanently instead of only archiving it.",
  "license": "MIT",
  "author": {
    "name": "T2h",
    "url": "https://github.com/FlowerSea111222"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlowerSea111222/dsh-session-delete.git"
  },
  "homepage": "https://github.com/FlowerSea111222/dsh-session-delete#readme",
  "type": "module",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "session",
    "delete"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-context-menu"
      ]
    }
  }
}
